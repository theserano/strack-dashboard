{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": "./",
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "./**/*.json"],
  "files": ["src/utils/express.d.ts"],
  "exclude": ["dist", "node_modules"]
}
